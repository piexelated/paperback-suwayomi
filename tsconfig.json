{
	"compilerOptions": {
		"target": "ES2020",
		"module": "commonjs",
		"outDir": "./lib",
		"rootDir": "./src",
		"strict": true,
		"noImplicitReturns": true,
		"noFallthroughCasesInSwitch": true,
		"noUncheckedIndexedAccess": true,
		"noImplicitOverride": true,
		"moduleResolution": "node",
		"esModuleInterop": true,
		"skipLibCheck": true,
		"types": [],
		"forceConsistentCasingInFileNames": true
	},
	"include": ["src"]
}
